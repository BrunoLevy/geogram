#!/bin/sh
# Wrapper for the RobotFramework test runner

scriptdir=`dirname "$0"`
. "$scriptdir/testenv.sh" || exit 1
if robot $args ; then
    > TESTS_SUCCESS
fi

# Some Jenkins plugins (like the Jenkins Performance Plugin) do not take
# testcase fullnames into account. Testnames with identical names but from
# different testsuites are considered a single testcase. This results in
# erroneous reports and graphs. We must patch the xunit file generated by
# RobotFramework and replace testcase names by their full names.

if [ -f xunit.xml ]; then
    echo "Generating XUnit report with full testcase names"
    perl "$VORPALINE_SOURCE_DIR/tools/jenkins/xunit_full_names.pl" xunit.xml > xunit_full_names.xml
fi

# Generate a human-redable coverage report
# (one can use --xml instead to generate a cobertura-compatible report)
# Exclude third party libraries and graphics programs from report

if [ "$VORPALINE_WITH_GCOV" = 1 ]; then
    echo "Generating coverage report"
    gcovr --version
    gcovr --gcov-exclude-directories \
             lib/third_party \
             lib/geogram/third_party \
             lib/exploragram \
             tests/test_nn_search/third_party \
             examples/exploragram \
             examples/graphics \
             bin/geobox bin/geocod bin/geoCSG bin/geoshade bin/vorpaview \
          --html-nested --html-theme github.green --output=coverage.html \
          --verbose \
          -r $VORPALINE_SOURCE_DIR/src $VORPALINE_BUILD_DIR > coverage.log
fi
